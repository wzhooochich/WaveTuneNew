<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WaveTuneNew.ViewModels"
             x:Class="WaveTuneNew.ProfilePage"
             Title="Профиль"
             BackgroundColor="#FF1E1E1E">

    <ContentPage.BindingContext>
        <vm:ProfileViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="60, *">

        <Grid Grid.Row="0"
              BackgroundColor="#FF1E1E1E"
              ColumnDefinitions="Auto, *"
              Padding="10,8"
              ColumnSpacing="10">

            <ImageButton Grid.Column="0"
                         Source="back.png"
                         HeightRequest="20"
                         WidthRequest="20"
                         BackgroundColor="Transparent"
                         Clicked="OnBackClicked"
                         ToolTipProperties.Text="Назад"
                         VerticalOptions="Center"
                         Margin="4,0" />

            <Label Grid.Column="1"
                   Text="Профиль"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Button x:Name="AdminButton"
                    Grid.Column="1"
                    Text="⚙️ Админ-панель"
                    Clicked="OnAdminPanelClicked"
                    BackgroundColor="#BB86FC"
                    TextColor="Black"
                    HorizontalOptions="End"
                    Margin="0,0,10,0"
                    IsVisible="False"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <VerticalStackLayout BackgroundColor="#FF2D2D30"
                                     Padding="24,30,24,24"
                                     Spacing="14">

                    <Grid HorizontalOptions="Center"
                          WidthRequest="116"
                          HeightRequest="116">

                        <Border StrokeShape="Ellipse"
                                Stroke="#602191"
                                StrokeThickness="3"
                                HeightRequest="116"
                                WidthRequest="116">
                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                        </Border>

                        <Border StrokeThickness="0"
                                BackgroundColor="#602191"
                                StrokeShape="Ellipse"
                                HeightRequest="32"
                                WidthRequest="32"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                ToolTipProperties.Text="Изменить фото профиля">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickAvatarCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✎"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding DisplayName}"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding Login, StringFormat='@{0}'}"
                           TextColor="#888888"
                           FontSize="13"
                           HorizontalOptions="Center"
                           Margin="0,-8,0,0" />

                    <BoxView HeightRequest="1" BackgroundColor="#3D3D3D" Margin="0,4" />

                    <Label Text="{Binding Bio}"
                           TextColor="#CCCCCC"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" BackgroundColor="#FF252526" HeightRequest="50">
                    <Button Grid.Column="0"
                            Text="ПОНРАВИВШИЕСЯ ТРЕКИ"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CharacterSpacing="1.5"
                            BackgroundColor="{Binding TracksTabButtonColor}"
                            CornerRadius="0"
                            Command="{Binding SwitchToTracksCommand}" />

                    <Button Grid.Column="1"
                            Text="ПОНРАВИВШИЕСЯ АЛЬБОМЫ"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CharacterSpacing="1.5"
                            BackgroundColor="{Binding AlbumsTabButtonColor}"
                            CornerRadius="0"
                            Command="{Binding SwitchToAlbumsCommand}" />
                </Grid>

                <!-- Треки -->
                <VerticalStackLayout IsVisible="{Binding IsTracksTabVisible}" Padding="15">
                    <CollectionView ItemsSource="{Binding LikedSongs}">
                        <CollectionView.EmptyView>
                            <Grid HeightRequest="150">
                                <Label Text="Понравившиеся треки появятся здесь"
                                       TextColor="#555555"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="14" />
                            </Grid>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="52, *" Padding="4,6" ColumnSpacing="12">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#2A2A2A" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.GoToSongCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            HeightRequest="52"
                                            WidthRequest="52">
                                        <Image Source="{Binding PictureUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding Title}"
                                               TextColor="White"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               MaxLines="1" />
                                        <Label Text="{Binding Author}"
                                               TextColor="#B3B3B3"
                                               FontSize="12"
                                               MaxLines="1" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Альбомы -->
                <VerticalStackLayout IsVisible="{Binding IsAlbumsTabVisible}" Padding="15">
                    <CollectionView ItemsSource="{Binding LikedAlbums}">
                        <CollectionView.EmptyView>
                            <Grid HeightRequest="150">
                                <Label Text="Сохраненные альбомы появятся здесь"
                                       TextColor="#555555"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="14" />
                            </Grid>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="52, *" Padding="4,6" ColumnSpacing="12">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#2A2A2A" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.GoToAlbumCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            HeightRequest="52"
                                            WidthRequest="52">
                                        <Image Source="{Binding PictureUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding Title}"
                                               TextColor="White"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               MaxLines="1" />
                                        <Label Text="{Binding Author}"
                                               TextColor="#B3B3B3"
                                               FontSize="12"
                                               MaxLines="1" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
